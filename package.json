{
  "name": "tow-companion",
  "private": true,
  "version": "0.1.491",
  "type": "module",
  "description": "Warhammer: The Old World turn companion - mobile PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "scrape": "node scripts/scrape.mjs",
    "import-renegade-reference": "node scripts/import-renegade-reference.mjs",
    "compile-renegade-v2": "node scripts/compile-renegade-v2.mjs",
    "patch-renegade-spell-layout": "node scripts/patch-renegade-spell-layout.mjs",
    "compile-renegade-lores": "node scripts/compile-renegade-lores.mjs",
    "patch-renegade-yellow": "node scripts/patch-renegade-yellow.mjs",
    "patch-renegade-equipment": "node scripts/patch-renegade-equipment.mjs",
    "patch-renegade-added-units": "node scripts/patch-renegade-added-units.mjs",
    "renegade": "npm run patch-renegade-added-units && npm run compile-renegade-v2 && npm run compile-renegade-lores && npm run patch-renegade-spell-layout && npm run patch-renegade-yellow && npm run patch-renegade-equipment && npm run patch-dark-elves-v2 && npm run patch-vampire-counts-v2 && npm run validate-renegade-v2 && npm run test:dark-elves-v2 && npm run test:vampire-counts-v2",
    "patch-dark-elves-v2": "node scripts/patch-dark-elves-v2.mjs",
    "test:dark-elves-v2": "node --test scripts/tests/dark-elves-v2.test.cjs",
    "patch-vampire-counts-v2": "node scripts/patch-vampire-counts-v2.mjs",
    "test:vampire-counts-v2": "node --test scripts/tests/vampire-counts-v2.test.cjs",
    "test:veteraan-rapport": "node --test scripts/tests/veteraan-rapport.test.cjs",
    "test:campagne-uitkomst": "node --test scripts/tests/campagne-uitkomst.test.cjs",
    "validate-renegade-v2": "node scripts/validate-renegade-v2.mjs",
    "audit-renegade": "node scripts/audit-renegade.mjs",
    "validate-renegade-reference": "node scripts/validate-renegade-reference.mjs",
    "sync-mount-details": "node scripts/sync-mount-details.mjs",
    "sync-unit-details": "node scripts/sync-unit-details.mjs",
    "sync-new-recruit-items": "node scripts/sync-new-recruit-items.mjs",
    "sync-owb": "node scripts/sync-owb.mjs && node scripts/patch-owb-magic-items.mjs && node scripts/patch-owb-army-fixes.mjs",
    "stamp-version": "node scripts/stamp-version.mjs",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json --noEmit",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "node scripts/build-mcp.mjs --check && node --test scripts/tests/mcp.test.cjs",
    "render-brand": "node scripts/render-brand.mjs",
    "dev:test": "vite --mode test",
    "build:test": "vite build --mode test",
    "pdf-preview": "node scripts/pdf-preview.mjs",
    "test:statlines": "node --test scripts/tests/statlines.test.cjs",
    "test:battle-march-objectives": "node --test scripts/tests/battle-march-objectives.test.cjs",
    "test:veteraan-stats": "node --test scripts/tests/veteraan-stats.test.cjs",
    "test:mathhammer": "node --test scripts/tests/mathhammer.test.cjs",
    "patch-owb-army-fixes": "node scripts/patch-owb-army-fixes.mjs",
    "test:builder-fixes": "node --test scripts/tests/builder-fixes.test.cjs",
    "test:extra-items": "node --test scripts/tests/extra-items.test.cjs",
    "test:new-recruit": "node --test scripts/tests/new-recruit-import.test.cjs",
    "test:list-merge": "node --test scripts/tests/list-merge.test.cjs",
    "test:versterking": "node --test scripts/tests/versterking.test.cjs",
    "test:campaign-terrain": "node --test scripts/tests/campaign-terrain.test.cjs",
    "test:scenario-bonus": "node --test scripts/tests/scenario-bonus.test.cjs",
    "test:scenario-units": "node --test scripts/tests/scenario-units.test.cjs",
    "test:tafel": "node --test scripts/tests/tafel.test.cjs",
    "tactics:list": "node tactics/lijst.mjs",
    "tactics:select": "node tactics/selectie.mjs",
    "tactics:dates": "node tactics/datums.mjs",
    "tactics:sources": "node tactics/bronnen.mjs",
    "tactics:glossary": "node tactics/glossary.mjs",
    "tactics:transcript": "node tactics/transcript.mjs",
    "tactics:build": "node tactics/bouw.mjs",
    "tactics:check": "node tactics/bouw.mjs --check",
    "tactics:codex": "node tactics/codex/run.mjs",
    "tactics:merge": "node tactics/codex/samenvoegen.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "pdfmake": "^0.3.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0"
  }
}
